# TeleMesh - Multi-Project .gitignore

# Editor and IDE files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# OS files
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
/tmp/
.tmp/

# Log files
*.log
logs/
*.log.*

# Environment files (may contain secrets)
.env
.env.local
.env.*.local

# Terraform files
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
.terraform.lock.hcl
*.tfvars.backup
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Common build output directories
/build/
/dist/
/out/
/target/
/bin/
/.next/
/.nuxt/

# Python virtual environments and cache
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/

# Python testing
.pytest_cache/
.tox/
.nox/
htmlcov/
.coverage
*.coverage
coverage.xml
*.cover

# PlatformIO (edge-esn-firmware)
.pio/
.pioenvs/
.piolibdeps/

# Arduino
edge-esn-firmware/.pio/
edge-esn-firmware/lib/*/
!edge-esn-firmware/lib/.gitkeep

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Kubernetes
*.kubeconfig

# Ansible
*.retry
ansible/inventory/*.yml
!ansible/inventory/example.yml

# Vault
*.vault

# Overlay networks
*.tailscale
*.zerotier

# Coverage reports
/coverage/
.nyc_output/

# Test output
/test-results/

# Debug files
*.pdb
*.dSYM/

# Secrets (never commit these)
secrets/
*.pem
*.key
*.crt
!*.example.key
_codeql_detected_source_root
